{
  "name": "lucas-soares-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lucas Soares — portfolio. Code. Design. Intelligence.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c gray,blue \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "media": "node scripts/encode-video.mjs",
    "ask:demo": "tsx scripts/ask-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
