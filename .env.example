# Ask My Portfolio — server-side only. Never prefix with VITE_.
# Without a key the assistant runs in demo mode (local retrieval, no LLM).
ANTHROPIC_API_KEY=
# Optional overrides
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
PORT=8787
# Requests per IP per 10 minutes, and a global daily cap on LLM calls.
RATE_LIMIT_PER_10MIN=20
DAILY_LLM_CAP=500
